# ─────────────────────────────────────────────────────────────
# Emily Interview Agent — environment variables
# Copy to `.env.local` for local development. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL). Local: docker compose up -d  |  Prod: Neon / Supabase
DATABASE_URL=postgres://emily:emily@localhost:5432/emily

# Admin auth (TODO: replace with Better Auth / Auth.js session secret)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_ALLOWED_EMAILS=cnoriega@leapimg.com,kdmadariagab@gmail.com

# ── Voice agent (STT + LLM + TTS) ────────────────────────────
# Which voice provider the interview page uses: "deepgram" | "openai-realtime"
VOICE_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Used when VOICE_PROVIDER=openai-realtime and for post-interview summaries
OPENAI_API_KEY=

# ── LLM (summaries / structured extraction) ──────────────────
# "openai" | "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Emily <emily@yourdomain.com>"
EMAIL_REPORT_TO=cnoriega@leapimg.com

# ── Notion ───────────────────────────────────────────────────
NOTION_API_KEY=
# Data source id of the "Emily Interviews" database (Notion API >= 2025-09-03)
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2025-09-03

# ── Background jobs ──────────────────────────────────────────
# Shared secret that Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=change-me
