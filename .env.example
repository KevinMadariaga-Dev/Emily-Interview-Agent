# ─────────────────────────────────────────────────────────────
# Emily Interview Agent — environment variables
# Copy to `.env.local` for local development. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL). Local: docker compose up -d  |  Prod: Neon / Supabase
DATABASE_URL=postgres://emily:emily@localhost:5432/emily

# Admin auth (TODO: replace with Better Auth / Auth.js session secret)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_ALLOWED_EMAILS=cnoriega@leapimg.com,kdmadariagab@gmail.com

# Optional: password for the whole site (HTTP Basic, any username). Set it on public deploys.
SITE_PASSWORD=

# ── Voice agent (STT + LLM + TTS) ────────────────────────────
# Which voice provider the interview page uses: "deepgram" | "openai-realtime"
VOICE_PROVIDER=deepgram
DEEPGRAM_API_KEY=
# Used when VOICE_PROVIDER=openai-realtime, for summaries and for the landing's voice setup
OPENAI_API_KEY=
# Landing voice setup (speech-to-text / text-to-speech)
OPENAI_STT_MODEL=gpt-4o-transcribe
# gpt-4o-mini-tts + fixed language instructions keeps Emily in one language and one voice.
# (tts-1-hd guesses the language per line and can switch to English mid-interview.)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ── LLM (summaries / structured extraction) ──────────────────
# "openai" | "anthropic"
LLM_PROVIDER=openai
# gpt-5.6-luna: better follow-ups than gpt-4.1-mini, cheaper, ≈2.5 s per turn (benchmarked)
LLM_MODEL=gpt-5.6-luna
# reasoning models only: none | minimal | low | medium | high
LLM_REASONING_EFFORT=low
ANTHROPIC_API_KEY=

# ── Email: Gmail (preferred when set) ─────────────────────────
# Gmail account + App Password (myaccount.google.com/apppasswords, needs 2-Step Verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Emily · NEOera
# Optional: only these emails / @domains may receive reports (recommended while there is no login)
REPORT_EMAIL_ALLOWLIST=

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Emily <emily@yourdomain.com>"
EMAIL_REPORT_TO=cnoriega@leapimg.com

# ── Notion ───────────────────────────────────────────────────
NOTION_API_KEY=
# Data source id of the "Emily Interviews" database (Notion API >= 2025-09-03)
NOTION_DATA_SOURCE_ID=
NOTION_API_VERSION=2025-09-03

# ── Background jobs ──────────────────────────────────────────
# Shared secret that Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=change-me
